<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:fitsSystemWindows="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/app_name"
            android:textColor="@color/text"
            android:textSize="26sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/status"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:textColor="@color/text_dim"
            android:textSize="16sp" />

        <TextView
            android:id="@+id/heard"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:textColor="@color/listening"
            android:textSize="16sp" />

        <Button
            android:id="@+id/toggle"
            android:layout_width="match_parent"
            android:layout_height="64dp"
            android:layout_marginTop="16dp"
            android:text="Avvia ascolto"
            android:textAllCaps="false"
            android:textSize="18sp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="28dp"
            android:text="Cosa serve"
            android:textColor="@color/text"
            android:textSize="18sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/checks"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:lineSpacingExtra="6dp"
            android:textColor="@color/text"
            android:textSize="16sp" />

        <Button
            android:id="@+id/grant"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="Concedi microfono, rubrica, chiamate, notifiche"
            android:textAllCaps="false" />

        <Button
            android:id="@+id/overlay"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Consenti «Mostra sopra altre app»"
            android:textAllCaps="false" />

        <Button
            android:id="@+id/battery"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Escludi dal risparmio batteria"
            android:textAllCaps="false" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="28dp"
            android:text="Frase di attivazione"
            android:textColor="@color/text"
            android:textSize="18sp"
            android:textStyle="bold" />

        <EditText
            android:id="@+id/wake"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="es. ehi computer"
            android:importantForAutofill="no"
            android:inputType="text" />

        <Button
            android:id="@+id/wake_save"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Salva frase di attivazione"
            android:textAllCaps="false" />

        <TextView
            android:id="@+id/wake_check"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:lineSpacingExtra="3dp"
            android:textColor="@color/text_dim"
            android:textSize="15sp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="Consiglio: due parole che non dici spesso insieme (es. «ehi computer», «ok telefono»). Guarda la riga «Sento» qui sopra mentre la provi."
            android:textColor="@color/text_dim"
            android:textSize="14sp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="28dp"
            android:text="Chiamate"
            android:textColor="@color/text"
            android:textSize="18sp"
            android:textStyle="bold" />

        <Switch
            android:id="@+id/speaker"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:minHeight="48dp"
            android:text="Chiamate sempre in vivavoce"
            android:textColor="@color/text"
            android:textSize="16sp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Oppure dillo a voce: «chiama Mario in vivavoce»."
            android:textColor="@color/text_dim"
            android:textSize="14sp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="28dp"
            android:text="Riconoscimento dei comandi"
            android:textColor="@color/text"
            android:textSize="18sp"
            android:textStyle="bold" />

        <Switch
            android:id="@+id/system_asr"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:minHeight="48dp"
            android:text="Usa il riconoscimento del telefono (molto più preciso)"
            android:textColor="@color/text"
            android:textSize="16sp" />

        <TextView
            android:id="@+id/asr_info"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:lineSpacingExtra="3dp"
            android:textColor="@color/text_dim"
            android:textSize="15sp" />

        <Button
            android:id="@+id/download_it"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Scarica l'italiano offline"
            android:textAllCaps="false" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="28dp"
            android:text="Voce dell'assistente"
            android:textColor="@color/text"
            android:textSize="18sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tts_info"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:lineSpacingExtra="3dp"
            android:textColor="@color/text_dim"
            android:textSize="15sp" />

        <Button
            android:id="@+id/tts_install"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Installa / aggiorna la voce italiana"
            android:textAllCaps="false" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="28dp"
            android:text="Luoghi rapidi"
            android:textColor="@color/text"
            android:textSize="18sp"
            android:textStyle="bold" />

        <EditText
            android:id="@+id/home"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Indirizzo di casa («portami a casa»)"
            android:importantForAutofill="no"
            android:inputType="textPostalAddress" />

        <EditText
            android:id="@+id/work"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Indirizzo del lavoro («portami al lavoro»)"
            android:importantForAutofill="no"
            android:inputType="textPostalAddress" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="28dp"
            android:text="Come si usa"
            android:textColor="@color/text"
            android:textSize="18sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/howto"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:lineSpacingExtra="4dp"
            android:textColor="@color/text_dim"
            android:textSize="16sp" />
    </LinearLayout>
</ScrollView>
